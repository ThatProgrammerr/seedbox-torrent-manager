# ============================================================
# qBittorrent — Primary Instance (required)
# ============================================================
QB_HOST=https://USERNAME.SERVER.usbx.me/qbittorrent
QB_PORT=443
QB_USERNAME=admin
QB_PASSWORD=adminadmin

# ============================================================
# Server Mode (optional)
#
# Set to true if you are running this script directly on the seedbox itself
# rather than from a remote machine.
#
# When enabled:
#   - Storage and traffic data is read locally via 'quota -s' and
#     'app-traffic info' instead of calling the Ultra API.
#     API_URL and BEARER_TOKEN are not needed.
#   - COMMAND_LIMIT_HIT and COMMAND_LIMIT_REFRESHED are executed locally
#     instead of over SSH. SSH variables are not needed.
#   - If a local command fails, the script will exit immediately with an error.
#
# Requires: quota and app-traffic to be available on the system.
# ============================================================
RUNNING_ON_SERVER=false

# ============================================================
# Storage / Traffic API (UltraSeedbox-specific, optional)
# Not needed if RUNNING_ON_SERVER=true.
# Used for storage-based cleanup and traffic limit monitoring.
# Leave both empty to disable these features.
# ============================================================
API_URL=https://USERNAME.SERVER.usbx.me/ultra-api/total-stats
BEARER_TOKEN=your_bearer_token_here

# ============================================================
# Discord Webhooks (optional — leave empty to disable)
#
# If DISCORD_WEBHOOK_URL is not set, you will not receive notifications for:
#   - Torrent deletions from storage cleanup
#   - Traffic and storage limit alerts
#   - Hourly free storage summaries
#   - qBittorrent connection errors
#   Events will still appear in the script's log output.
#
# If INACTIVE_DISCORD_URL is not set, you will not receive notifications for:
#   - Tracker-specific inactive torrent deletions (TorrentLeech, IPT, etc.)
#
# ORPHAN_DISCORD_URL is optional. If set, orphan-folder check notifications
# are sent there. If empty, orphan notifications fall back to DISCORD_WEBHOOK_URL.
# ============================================================
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXX/XXXXX
INACTIVE_DISCORD_URL=https://discord.com/api/webhooks/XXXX/XXXXX
ORPHAN_DISCORD_URL=https://discord.com/api/webhooks/XXXX/XXXXX

# ============================================================
# SSH — for running remote commands when limits are hit
# Not needed if RUNNING_ON_SERVER=true (commands run locally instead).
#
# If left empty, the following features are disabled:
#   - Stopping AutoBRR (the app that automatically adds new torrents to qBittorrent) when the monthly traffic limit is reached
#   - Stopping AutoBRR when storage drops below the minimum threshold
#   - Restarting AutoBRR when traffic or storage recovers
#
# WARNING: Without SSH configured, AutoBRR will continue adding new torrents
# even when your storage is full or your monthly traffic quota is exhausted.
# This will cause your disk to fill up completely, prevent upload credit from
# being earned, and may cause errors on your seedbox. Unless you have an
# exceptionally large storage drive, configuring SSH is strongly recommended.
# ============================================================
SSH_SERVER=SERVER.usbx.me
SSH_PORT=22
SSH_USERNAME=your_ssh_username
SSH_KEY=/home/youruser/.ssh/id_rsa
# Set to true to reject unknown host keys (requires the host to be in ~/.ssh/known_hosts).
# false (default) auto-accepts any host key — convenient but less secure.
SSH_STRICT_HOST_KEYS=false

# The SSH commands to run when limits are hit or recovered.
# On UltraSeedbox these use the built-in app management commands.
# Adjust to match your server (e.g. "systemctl stop autobrr" on a VPS).
#
# If COMMAND_LIMIT_HIT is not set: AutoBRR will keep adding new torrents
#   even when traffic or storage is exhausted.
# If COMMAND_LIMIT_REFRESHED is not set: AutoBRR will not be automatically
#   restarted when traffic or storage recovers.
COMMAND_LIMIT_HIT=app-autobrr stop
COMMAND_LIMIT_REFRESHED=app-autobrr start

# ============================================================
# Cleanup Thresholds
# ============================================================
# Minimum free GB before triggering storage-based torrent deletion
MIN_FREE_GB=300

# Maximum number of torrents to delete in a single cleanup pass
MAX_DELETIONS_PER_RUN=5

# Alert if the gap between API-reported usage and qBittorrent total exceeds this (GB)
STORAGE_MISMATCH_THRESHOLD_GB=200

# Percentage of traffic used before triggering the limit command
TRAFFIC_LIMIT_THRESHOLD=98

# ============================================================
# Unregistered Torrent Cleanup
# ============================================================
# If set to false, torrents that trackers have marked as 'unregistered'
# will not be automatically removed.
UNREGISTERED_CHECK_ENABLED=true
# Hours of inactivity required before an unregistered torrent is deleted
UNREGISTERED_INACTIVE_HOURS=6

# ============================================================
# Orphan Folder Cleanup (optional)
#
# Scans the qBittorrent seed directory for folders that are no longer attached
# to any active torrent in qBittorrent, then moves them into a delete folder.
# This is safer than deleting files directly because users can restore files
# before emptying the delete folder.
#
# In RUNNING_ON_SERVER=true mode this runs locally.
# In remote mode this requires SSH settings above.
# ============================================================
ORPHAN_CHECK_ENABLED=false
# qBittorrent seed root folder (same base path used in content_path values)
ORPHAN_REMOTE_PATH=/home/youruser/media/seed
# Destination folder for moved orphaned folders (default: ORPHAN_REMOTE_PATH/../delete)
ORPHAN_DELETE_PATH=/home/youruser/media/delete
# Set to false for dry-run reporting only (no folders moved)
ORPHAN_MOVE_ENABLED=false
# How often orphan checks run (hours)
ORPHAN_CHECK_INTERVAL_HOURS=6
# Comma-separated folder names to never move (case-insensitive)
ORPHAN_IGNORE_FOLDERS=incomplete,temp

# ============================================================
# Timezone
# Used when displaying torrent activity timestamps in Discord.
# Any valid IANA timezone string is accepted (e.g. America/New_York,
# Europe/London, Australia/Sydney).
# ============================================================
TIMEZONE=Europe/Amsterdam
